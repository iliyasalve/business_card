{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iliyaglazunov-com",
  "compatibility_date": "2026-09-08",

  // Привязка домена держится здесь, а не только в панели: иначе конфиг и
  // реальное состояние расходятся молча. www сюда не входит намеренно —
  // он закрыт правилом редиректа на уровне зоны, иначе сайт оказался бы
  // доступен по двум адресам сразу.
  "routes": [
    { "pattern": "iliyaglazunov.com", "custom_domain": true }
  ],

  // Ни "main", ни "binding": скрипта-воркера нет, отдаётся чистая статика.
  // Такие запросы у Cloudflare бесплатны и не лимитированы.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
