{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iliyaglazunov-com",
  "compatibility_date": "2026-09-08",

  // Ни "main", ни "binding": скрипта-воркера нет, отдаётся чистая статика.
  // Такие запросы у Cloudflare бесплатны и не лимитированы.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
